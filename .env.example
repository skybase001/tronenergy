# Copy to .env and replace credentials. Keys are not supplied by the project.
POSTGRES_PASSWORD=replace-with-local-database-password
TE_DATABASE_URL=postgresql://tronenergy:replace-with-local-database-password@localhost:5432/tronenergy
TE_REDIS_URL=redis://localhost:6379/0
TE_API_KEYS={"replace-with-customer-api-key":"tenant-demo"}
TE_ADMIN_KEYS=["replace-with-admin-api-key"]
TE_INTERNAL_TOKEN=replace-with-random-service-token
TE_SIGNER_TOKEN=replace-with-different-random-signer-token
TE_NETWORK=nile
TE_RPC_URL=https://nile.trongrid.io
TE_RPC_API_KEY=
TE_GENESIS_BLOCK_ID=
TE_CHAIN_URL=http://localhost:8002
TE_RENTAL_URL=http://localhost:8001
TE_SIGNER_URL=http://localhost:8003
TE_PRIVATE_KEY_FILE=config/local/signer.key
TE_SIGNING_ENABLED=false
TE_BROADCASTING_ENABLED=false
TE_MAX_STAKE_SUN=100000000000
TE_TOKEN_CONTRACTS=[]
TE_DURATION_OPTIONS=[3600,86400]
TE_PRICE_PER_MILLION_UNIT_HOUR_SUN=1000000
TE_QUOTE_TTL_SECONDS=30
TE_LOG_LEVEL=INFO
